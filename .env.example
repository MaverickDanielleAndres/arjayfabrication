# Google AI Studio server key. Never expose this as NEXT_PUBLIC_*.
GEMINI_API_KEY=
# Stable Flash model checked against current Gemini documentation.
GEMINI_MODEL=gemini-3.6-flash

# HTTPS endpoint that accepts a JSON enquiry payload and returns a 2xx response.
ENQUIRY_WEBHOOK_URL=
# Optional bearer token sent to the enquiry webhook.
ENQUIRY_WEBHOOK_TOKEN=

# Recommended for distributed production rate limiting. Without these,
# the app uses a per-instance in-memory fallback suitable for local testing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
